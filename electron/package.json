{
  "name": "notcha",
  "version": "3.3.1",
  "description": "Dynamic island desktop notch companion for Windows and macOS with focus timer, media player, app shortcuts, clipboard history, and power controls",
  "main": "main.js",
  "author": "Ukacha Juma",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:all": "electron-builder -mw",
    "app": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ukacha.notcha",
    "productName": "Notcha",
    "directories": {
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "logo.png",
      "media-helper",
      "nowplaying-query.swift",
      "dock-helper",
      "dock-helper.swift",
      "dock-preview.html",
      "dock-preview.js",
      "qr-generator.js",
      "transfer-server.js",
      "mini-transfer.html",
      "mini-transfer.js",
      "send-window.html",
      "send-window.js",
      "receive-window.html",
      "receive-window.js"
    ],
    "asarUnpack": [
      "media-helper",
      "dock-helper",
      "nowplaying-query.swift"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
